/*
 * conf/hpc.config — Konfigurasi untuk HPC Mahameru BRIN
 * Executor : SLURM
 * Catatan  : label process_* di blok process utama nextflow.config ditulis
 *            sesudah blok profiles, sehingga menimpa nilai label di berkas ini
 *            (alokasi efektif 2/4/8 core, 4/8/16 GB). Lihat README.md.
 * Partition: medium-small (max 3 hari, sesuai sinfo output)
 * Container: TIDAK dipakai lagi untuk Cactus — native binary install (lihat CACTUS_MINIGRAPH
 *            di bawah), karena Singularity gagal "unknown userid" di beberapa node akibat
 *            cache sssd/LDAP yang tidak konsisten (lihat README.md). Tools lain pakai conda.
 */

params {
    max_cpus   = 32
    max_memory = "64.GB"
    max_time   = "72.h"
}

// Batasi concurrent SLURM submissions supaya tidak kena AssocMaxSubmitJobLimit
// queueSize = max job yang bisa submit sekaligus ke SLURM
executor {
    name            = 'slurm'
    queueSize       = 1          // akun student: maks 2 job berjalan, 1 untuk orkestrator
    submitRateLimit = '1/5sec'   // tunggu 5 detik antar submission
    pollInterval    = '30sec'    // cek status job tiap 30 detik
}

process {
    executor = 'slurm'
    queue    = 'medium-small'   // partisi yang tersedia di Mahameru

    withLabel: process_low {
        cpus   = { Math.min(4 * task.attempt, 32) }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { Math.min(8 * task.attempt, 32) }
        memory = { 16.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withLabel: process_high {
        cpus   = { Math.min(16 * task.attempt, 32) }
        memory = { 32.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    // Cactus: native binary install (bukan container) — hindari bug Singularity
    // "unknown userid" akibat cache sssd/LDAP yang tidak konsisten antar node.
    // Venv terinstall manual di $HOME/cactus-bin-v2.9.0/venv-cactus-v2.9.0 (lihat README.md).
    withName: 'CACTUS_MINIGRAPH' {
        container    = null
        conda        = null
        beforeScript = 'source $HOME/cactus-bin-v2.9.0/venv-cactus-v2.9.0/bin/activate'
    }
}

// Singularity dimatikan — tidak ada proses lagi yang butuh container di HPC
singularity {
    enabled = false
}

// Docker DIMATIKAN di HPC (tidak diizinkan di cluster multi-user)
docker {
    enabled = false
}
