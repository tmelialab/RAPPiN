/*
 * conf/test.config — Konfigurasi untuk testing lokal di laptop
 * Data: tests/test_data/ (subset kecil 3 assembly × 5 seq × 100kb)
 * Semua resource di-cap ke laptop (4 CPU, 4GB RAM)
 */

params {
    input          = "${projectDir}/tests/test_data/samplesheet.csv"
    reference_name = "EGPMv6"
    outdir         = "./results"
    max_cpus       = 4
    max_memory     = "4.GB"
    max_time       = "30.m"
    cactus_cores   = 2
}

process {
    cpus   = 2
    memory = '2.GB'
    time   = '10.m'

    withLabel: process_low    { cpus = 1; memory = '1.GB' }
    withLabel: process_medium { cpus = 2; memory = '2.GB' }
    withLabel: process_high   { cpus = 2; memory = '4.GB' }
}

// Enable Docker agar cactus-minigraph (yang pakai container) bisa jalan
docker {
    enabled    = true
    runOptions = '--rm'
}
