/*
========================================================================================
    RAPPiN — Nextflow Configuration
========================================================================================
    PANDUAN SINGKAT:
    Semua parameter pipeline diatur di blok params {} di bawah ini.
    Tidak perlu mengubah file lain — cukup ubah nilai di sini.

    Cara menjalankan:
        nextflow run main.nf -profile conda,test          ← laptop (test data)
        nextflow run main.nf -profile conda,slurm         ← HPC Mahameru
        nextflow run main.nf --input samplesheet.csv \    ← data penuh
                             --reference_name EG11 \
                             --outdir ./results
========================================================================================
*/

// ─────────────────────────────────────────────────────────────────────────────
// PARAMETER PIPELINE — UBAH DI SINI sesuai kebutuhan
// ─────────────────────────────────────────────────────────────────────────────
params {

    // ── INPUT / OUTPUT ────────────────────────────────────────────────────────
    input = null
    // Path ke samplesheet CSV (WAJIB diisi)
    outdir = "./results"
    // Folder output hasil pipeline
    mode = "full"
    // Mode: "full" | "graph_only"

    // ── PREPROCESSING — seqkit filter ────────────────────────────────────────
    // Sekuens yang lebih pendek dari nilai ini akan dibuang sebelum analisis.
    // Default: 500 bp. Naikkan nilainya jika ingin filter lebih ketat.
    min_seq_len = 500
    // [bp] panjang minimum sekuens yang disimpan

    // ── QC — QUAST ────────────────────────────────────────────────────────────
    // Nilai ini harus sama atau lebih besar dari min_seq_len di atas,
    // karena QUAST hanya menghitung contig yang melewati threshold ini.
    min_contig = 500
    // [bp] panjang minimum contig untuk laporan QUAST

    // ── KONSTRUKSI GRAPH — Minigraph (via cactus-minigraph) ───────────────────────────────────
    // reference_name WAJIB diisi dengan nilai kolom 'sample' dari samplesheet.
    // Contoh: "EG11" → assembly EG11 dijadikan backbone referensi pangenome.
    reference_name = "EG11"          // WAJIB: nama sample backbone referensi
    mg_preset      = "ggs"           // Preset minigraph: "ggs" = genome-vs-graph
    // Preset minigraph: "ggs" = genome-vs-graph
    mg_min_mapq = 5
    // Minimum mapping quality untuk minigraph

    // ── CACTUS — cactus-minigraph (konstruksi graf SV) ───────────────────────────────────
    cactus_cores = 8
    // Catatan: modul CACTUS_MINIGRAPH memakai task.cpus (label process_high),
    // sehingga parameter ini saat ini tidak berpengaruh.

    // ── RESOURCE LIMITS ───────────────────────────────────────────────────────
    // Batas maksimum resource per proses. Override oleh profile (test/slurm).
    max_memory = "16.GB"
    max_cpus = 8
    max_time = "24.h"
}

// ─────────────────────────────────────────────────────────────────────────────
// PROFILES — Pilih sesuai environment
// ─────────────────────────────────────────────────────────────────────────────
profiles {

    // ── Local (laptop/PC biasa, tanpa HPC) ───────────────────────────────────
    local {
        process.executor = 'local'
        docker.enabled = false
        singularity.enabled = false
        params.max_memory = "8.GB"
        params.max_cpus = 4
        params.max_time = "4.h"
    }

    // ── Docker ───────────────────────────────────────────────────────────────
    docker {
        docker.enabled = true
        docker.runOptions = '--rm'
        singularity.enabled = false
    }

    // ── Singularity (HPC) ────────────────────────────────────────────────────
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }

    // ── SLURM/HPC — pakai conf/hpc.config ──────────────────────────────────
    slurm {
        includeConfig 'conf/hpc.config'
    }

    // ── Conda — pakai environment 'pangenome' yang sudah di-install ────────
    //   Docker juga di-enable agar Cactus (hanya ada sebagai Docker image)
    //   tetap bisa jalan. Proses tanpa 'container' directive pakai conda env.
    conda {
        params.enable_conda = true
        conda.enabled = true
        process.conda = "${System.getProperty('user.home')}/miniforge3/envs/pangenome"
        docker.enabled = true
        docker.runOptions = '--rm'
    }

    // ── Test — pakai conf/test.config (laptop, resource kecil) ────────────
    test {
        includeConfig 'conf/test.config'
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// PROCESS DEFAULT SETTINGS
// ─────────────────────────────────────────────────────────────────────────────
process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: process_low {
        cpus = { Math.min(2 * task.attempt, params.max_cpus as int) }
        memory = { [4.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time = { 1.h * task.attempt }
    }

    withLabel: process_medium {
        cpus = { Math.min(4 * task.attempt, params.max_cpus as int) }
        memory = { [8.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time = { 4.h * task.attempt }
    }

    withLabel: process_high {
        cpus = { Math.min(8 * task.attempt, params.max_cpus as int) }
        memory = { [16.GB * task.attempt, params.max_memory as nextflow.util.MemoryUnit].min() }
        time = { 8.h * task.attempt }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// MANIFEST
// ─────────────────────────────────────────────────────────────────────────────
manifest {
    name = 'RAPPiN'
    author = 'Doni Arman S.'
    homePage = 'https://github.com/tmelialab/RAPPiN'
    description = 'Resource-Aware Pangenome Pipeline in Nextflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version = '0.1.0-dev'
}

// ─────────────────────────────────────────────────────────────────────────────
// REPORTING
// ─────────────────────────────────────────────────────────────────────────────
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/dag.html"
}
